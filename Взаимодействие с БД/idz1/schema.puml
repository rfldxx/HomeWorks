@startuml schema
!theme plain
hide circle
skinparam linetype ortho

' ============================================================
' Нотация: Crow's Foot (IE)
' ============================================================

entity "customers" as customers {
  * customer_id    : SERIAL       <<PK>>
  --
  customer_name    : TEXT
  customer_email   : TEXT
  customer_phone   : TEXT
  --
  UNIQUE (customer_name, customer_email)
}

entity "orders" as orders {
  * order_id         : INTEGER    <<PK>>
  --
  customer_id        : INTEGER    <<FK>>
  delivery_address   : TEXT
  total_amount       : INTEGER
}

entity "order_phases" as order_phases {
  * order_id   : INTEGER  <<PK, FK>>
  * status     : TEXT     <<PK>>
  --
  order_date   : DATE
}

entity "products" as products {
  * product_name  : TEXT     <<PK>>
  --
  product_price   : INTEGER
}

entity "order_items" as order_items {
  * order_id         : INTEGER  <<PK, FK>>
  * product_name     : TEXT     <<PK, FK>>
  --
  product_quantity   : INTEGER
}

' ============================================================
' Связи
' ============================================================

' Один клиент → много заказов
customers ||--o{ orders : "оформляет"

' Один заказ → много фаз
orders ||--o{ order_phases : "проходит"

' Один заказ → много позиций
orders ||--o{ order_items : "содержит"

' Один товар → много позиций
products ||--o{ order_items : "входит в"

@enduml